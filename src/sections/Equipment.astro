---
import BrandArrow from '../components/BrandArrow.astro';
import { Picture } from 'astro:assets';
import excavatorImage from '../assets/images/excavator-isolated.png';
import Button from '../components/Button.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { equipment } from '../data/equipment';
---

<section class="equipment-section" id="engins">
  <div class="equipment-section__layout wrap">
    <SectionIntro
      number="02"
      eyebrow="Nos engins"
      title="La puissance au service du terrain"
      description="LAMACO met à votre disposition ses engins pour la livraison, le terrassement et le nettoyage de terrain."
      tone="light"
    >
      <Button href="/engins/" variant="light">Découvrir nos engins</Button>
    </SectionIntro>

    <div class="equipment-visual">
      <!-- <span class="equipment-visual__label">Équipement disponible</span> -->
      <Picture
        src={excavatorImage}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1280]}
        sizes="(max-width: 640px) 100vw, (max-width: 960px) 52vw, 46vw"
        alt="Illustration d’une pelle hydraulique jaune sans marquage"
        loading="lazy"
        quality={65}
        width={1280}
        height={801}
      />
    </div>

    <div class="equipment-info" data-reveal>
      <p class="equipment-info__kicker">Parc actuel</p>
      {equipment.map((item, index) => (
        <article>
          <span>0{index + 1}</span>
          <div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
      <a href="/contact/" class="equipment-info__link">Parler de mon chantier <span aria-hidden="true"><BrandArrow glyph="↗" /></span></a>
    </div>
  </div>
</section>
