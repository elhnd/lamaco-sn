---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Equipment from '../sections/Equipment.astro';
import Hero from '../sections/Hero.astro';
import Materials from '../sections/Materials.astro';
import Process from '../sections/Process.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
---

<BaseLayout
  title={company.homeTitle}
  description={company.homeDescription}
>
  <Header />
  <main class="home-stack" id="contenu">
    <Hero />
    <Materials />
    <Equipment />
    <Process />
    <section class="about-strip" id="a-propos">
      <div class="wrap" data-reveal>
        <span>LAMACO · Sénégal</span>
        <p>{company.about}</p>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import '../lib/motion/home';
  </script>
</BaseLayout>
