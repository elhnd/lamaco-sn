---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  description: string;
  tone?: 'dark' | 'light';
}

const { number, eyebrow, title, description, tone = 'dark' } = Astro.props;
---

<div class:list={['section-intro', `section-intro--${tone}`]} data-reveal>
  <div class="section-intro__eyebrow">
    <span class="section-intro__number">{number}</span>
    <span class="section-intro__line" aria-hidden="true"></span>
    <span>{eyebrow}</span>
  </div>
  <h2>{title}</h2>
  <p>{description}</p>
  <slot />
</div>
