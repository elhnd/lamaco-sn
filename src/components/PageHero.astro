---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  breadcrumb: string;
  eyebrow: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
}
const { title, breadcrumb, eyebrow, description, image, imageAlt } = Astro.props;
---

<section class="page-hero" aria-labelledby="page-title">
  <div class="page-hero__image">
    <Picture src={image} formats={['avif']} fallbackFormat="webp" widths={[640, 1100, 1600]} sizes="(max-width: 600px) 100vw, 70vw" width={1600} height={780} alt={imageAlt} loading="eager" fetchpriority="high" quality={52} />
  </div>
  <div class="page-hero__veil" aria-hidden="true"></div>
  <div class="wrap page-hero__content">
    <nav class="page-hero__breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><span aria-current="page">{breadcrumb}</span></nav>
    <p class="page-hero__eyebrow"><span aria-hidden="true"></span>{eyebrow}</p>
    <h1 id="page-title">{title}<span>.</span></h1>
    <p class="page-hero__description">{description}</p>
  </div>
</section>

<style>
  .page-hero { position: relative; isolation: isolate; overflow: hidden; padding: 116px 0 72px; min-height: 450px; }
  .page-hero__image { position: absolute; z-index: -2; inset: 0 0 0 30%; }
  .page-hero__image :global(picture), .page-hero__image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .page-hero__veil { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, var(--c-bg) 12%, transparent 90%), linear-gradient(0deg, var(--c-bg), transparent 55%), linear-gradient(180deg, var(--c-bg), transparent 45%); }
  .page-hero__content { position: relative; }
  .page-hero__breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; color: var(--c-muted); font-size: 0.72rem; }
  .page-hero__breadcrumb a { display: inline-flex; align-items: center; min-height: 44px; }
  .page-hero__breadcrumb a:hover { color: var(--c-accent); }
  .page-hero__breadcrumb [aria-current] { color: var(--c-text); }
  .page-hero__eyebrow { display: flex; align-items: center; gap: 13px; margin: 21px 0 15px; color: var(--c-accent); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .page-hero__eyebrow > span { width: 29px; height: 1px; flex-shrink: 0; }
  .page-hero h1 { max-width: 1000px; margin: 0; font-family: var(--font-display); font-size: clamp(4rem, 6.7vw, 7rem); line-height: 0.94; font-weight: 700; letter-spacing: -0.025em; text-transform: uppercase; text-wrap: balance; }
  .page-hero h1 > span { color: var(--c-accent); }
  .page-hero__description { max-width: 440px; margin: 22px 0 0; color: var(--c-muted); font-size: 0.84rem; line-height: 1.9; }
  @media (max-width: 960px) {
    .page-hero { min-height: 410px; padding-bottom: 45px; }
  }
  @media (max-width: 600px) {
    .page-hero { padding-top: 104px; min-height: 400px; }
    .page-hero__image { left: 0; opacity: 0.5; }
    .page-hero__veil { background: linear-gradient(90deg, var(--c-bg), transparent), linear-gradient(0deg, var(--c-bg), transparent 85%); }
    .page-hero__eyebrow { font-size: 0.56rem; letter-spacing: 0.1em; }
    .page-hero h1 { font-size: clamp(2.8rem, 11vw, 4rem); }
    .page-hero__description { max-width: 330px; font-size: 0.78rem; }
  }
</style>
