---
import BrandArrow from './BrandArrow.astro';
import { contactDetails, contactLocation } from '../data/contact';
---

<aside class="contact-map" aria-labelledby="map-title" data-contact-map
  data-latitude={contactLocation.latitude} data-longitude={contactLocation.longitude} data-tile-url={contactLocation.tileUrl}>
  <div class="contact-map__viewport" data-map-viewport tabindex="0" role="group" aria-label="Carte de localisation LAMACO. Utilisez les flèches pour déplacer la carte et les boutons pour zoomer.">
    <div class="contact-map__tiles" data-map-tiles aria-hidden="true"></div>
    <div class="contact-map__caption"><p class="contact-eyebrow">Nous trouver</p><h2 id="map-title">Au plus près<br />de vos projets<span>.</span></h2></div>
    <div class="contact-map__marker" data-map-marker>
      <svg viewBox="0 0 40 52" width="40" height="52" aria-hidden="true"><path fill="currentColor" d="M20 1C9.5 1 2 8.8 2 19c0 13 18 32 18 32s18-19 18-32C38 8.8 30.5 1 20 1Z"/><circle cx="20" cy="19" r="6" fill="var(--c-bg)"/></svg>
      <a class="contact-map__label" href={contactDetails.mapHref} target="_blank" rel="noopener noreferrer"><strong>LAMACO <span>Sénégal</span></strong><span>Construire. Livrer. Équiper.</span><span class="contact-map__coordinates">{contactLocation.latitude.toFixed(6)}° N · {Math.abs(contactLocation.longitude).toFixed(6)}° O</span></a>
    </div>
    <div class="contact-map__controls" data-map-controls hidden>
      <button type="button" data-map-zoom="1" aria-label="Zoomer">+</button>
      <button type="button" data-map-zoom="-1" aria-label="Dézoomer">−</button>
      <button type="button" data-map-reset aria-label="Recentrer sur LAMACO"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/></svg></button>
    </div>
    <p class="contact-map__status" data-map-status role="status" hidden>Chargement de la carte…</p>
    <noscript><p class="contact-map__offline">Ouvrez Google Maps avec le lien ci-dessous pour consulter la carte.</p></noscript>
    <a class="contact-map__attribution" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>
  </div>
  <div class="contact-map__footer">
    <a class="contact-map__directions" href={contactDetails.directionsHref} target="_blank" rel="noopener noreferrer">Calculer mon itinéraire <span aria-hidden="true"><BrandArrow glyph="↗" /></span></a>
    <a href={contactDetails.mapHref} target="_blank" rel="noopener noreferrer">Ouvrir dans Google Maps <span aria-hidden="true"><BrandArrow glyph="↗" /></span></a>
  </div>
</aside>

<script>
  import { enableContactMap } from '../lib/contact-map';
  const map = document.querySelector<HTMLElement>('[data-contact-map]');
  if (map) enableContactMap(map);
</script>
