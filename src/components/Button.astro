---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'light';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
---

<a class:list={['button', `button--${variant}`, className]} href={href}>
  <span><slot /></span>
  <svg aria-hidden="true" viewBox="0 0 100 56" width="18" height="18" focusable="false">
    <use href="/brand/arrow.svg#arrow" />
  </svg>
</a>
