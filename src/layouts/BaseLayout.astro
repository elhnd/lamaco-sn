---
import '../styles/global.css';
import '../styles/brand-marks.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImage from '../assets/images/hero-quarry-v2.png';
import { company } from '../data/company';
import { canonicalUrl, pageGraph, serializeJsonLd, type Breadcrumb, type StructuredData } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  breadcrumbs?: Breadcrumb[];
  pageType?: 'WebPage' | 'CollectionPage' | 'ContactPage';
  structuredData?: StructuredData[];
}

const {
  title, description, noindex = false, image = defaultImage,
  imageAlt = 'Illustration d’une carrière avec une pelle, un camion-benne et des granulats',
  breadcrumbs = [], pageType = 'WebPage', structuredData = [],
} = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
// Build-only JPEG for sharing clients; never downloaded by the page itself.
const socialImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const socialImageUrl = new URL(socialImage.src, company.website).href;
const graph = pageGraph({ title, description, canonical, image: socialImageUrl, breadcrumbs, pageType, structuredData });
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
const bingVerification = import.meta.env.BING_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a0a09" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="fr_SN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="icon" type="image/svg+xml" href="/brand/icon.svg" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(graph)} />
  </head>
  <body>
    <slot />
    <script>
      import { enableGentleScroll } from '../lib/motion/gentle-scroll';
      enableGentleScroll();
    </script>
  </body>
</html>
